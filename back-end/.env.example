APP_NAME=reclame-ja-api
ENVIRONMENT=development
DEBUG=false

# Oracle Database; configure these values when enabling the Oracle adapter.
DB_USER=
DB_PASSWORD=
DB_DSN=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=5

REPORT_REPOSITORY=memory
PHOTO_MAX_BYTES=1000000
PHOTO_UPLOAD_SECRET=replace-with-at-least-32-random-characters
PHOTO_STORAGE_DIR=./var/photos
PUBLIC_API_BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=no-reply@reclameja.local
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
PUSH_TIMEOUT_SECONDS=10
GOOGLE_CLIENT_ID=

# Ollama must run locally; use null to keep classification fully offline.
CLASSIFIER=null
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL_SMALL=qwen2.5:3b
AI_MODEL_LARGE=qwen2.5:7b
AI_CONFIDENCE_THRESHOLD=0.7
AI_TIMEOUT_SECONDS=8
AI_CACHE_SIZE=512
REPORT_JOB_POLL_SECONDS=1
REPORT_JOB_LEASE_SECONDS=90
REPORT_JOB_MAX_ATTEMPTS=6
# true: a API também processa jobs (dev sem worker). No docker compose é false.
INLINE_JOB_PROCESSING=true
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000
# Diretório de Docker secrets (um arquivo por campo, ex.: jwt_secret).
SECRETS_DIR=
AGENCY_API_KEYS=

# Visual verification is disabled by default and fail-closed.
# Never enable an external provider without a legal/product decision.
VISUAL_VERIFICATION_ENABLED=false
VISUAL_VERIFICATION_PROVIDER=
