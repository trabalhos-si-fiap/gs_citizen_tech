# Configuração NÃO secreta do docker compose. Copie para .env e ajuste.
# Segredos ficam em ./secrets/*.txt (gere com ./scripts/init-secrets.sh).

ENVIRONMENT=development
IMAGE_TAG=local
REGISTRY_PREFIX=reclame-ja

# Portas publicadas somente em 127.0.0.1
API_PORT=8000
WEB_PORT=4200
MAILPIT_UI_PORT=8025
ORACLE_PORT=1521

ORACLE_IMAGE=gvenzl/oracle-free:23.6-slim-faststart
ORACLE_APP_USER=reclameja

PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# null | fake | ollama  (ollama exige --profile ai)
CLASSIFIER=null
# log | fcm
PUSH_PROVIDER=log
