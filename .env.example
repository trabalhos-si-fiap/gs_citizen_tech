# Configuração NÃO secreta do docker compose. Copie para .env e ajuste.
# Segredos ficam em ./secrets/*.txt (gere com ./scripts/init-secrets.sh).

ENVIRONMENT=development
IMAGE_TAG=local
REGISTRY_PREFIX=reclame-ja

# Portas publicadas somente em 127.0.0.1
API_PORT=8000
WEB_PORT=4200
MAILPIT_UI_PORT=8025
ORACLE_PORT=1521

ORACLE_IMAGE=gvenzl/oracle-free:23.6-slim-faststart
ORACLE_APP_USER=reclameja

PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# null | fake | ollama  (ollama exige --profile ai e o modelo baixado:
#   docker compose --profile ai up -d ollama
#   docker compose exec ollama ollama pull qwen2.5:3b)
CLASSIFIER=ollama
# none | fake. Com "fake" (só development), a classificação continua funcionando
# por regras de palavra-chave quando o Ollama está fora do ar ou sem o modelo.
AI_FALLBACK=fake
# Modelos usados nas duas etapas (o grande só quando a confiança é baixa).
AI_MODEL_SMALL=qwen2.5:3b
AI_MODEL_LARGE=qwen2.5:7b
# log | fcm
PUSH_PROVIDER=log
